# Required
PESC_LOGIN=79001234567
PESC_PASSWORD=your_password

# Required for authentication (value from browser DevTools → Network → /api/v8/users/auth → Request Headers)
# PESC_AUTH_VERIFICATION=

# Required only if 2FA (TOTP) is enabled on the account
# PESC_TOTP_SECRET=BASE32SECRET

# Required only if running outside Russia (pesc.ru geo-blocks non-RU IPs)
# PESC_PROXY_URL=http://your-ru-proxy:7890

# Directory for SQLite database (default: ./data)
# DATA_DIR=data

# Auto-submit schedule: time of day in Moscow time (default: 12:00)
# SCHEDULER_HOUR=12
# SCHEDULER_MINUTE=0
